# AQABSI integration configuration
# Copy variable names into an approved secret manager or local shell session.
# Never commit a populated copy and never paste token values into chat.
#
# Confluence Cloud API tokens:
# https://id.atlassian.com/manage-profile/security/api-tokens
# ClickUp personal tokens:
# https://app.clickup.com/settings/apps

# Confluence: choose cloud or data_center.
AQABSI_CONFLUENCE_DEPLOYMENT=
AQABSI_CONFLUENCE_BASE_URL=
AQABSI_CONFLUENCE_EMAIL=
AQABSI_CONFLUENCE_API_TOKEN=
AQABSI_CONFLUENCE_PAT=
AQABSI_CONFLUENCE_SPACE_ID=
AQABSI_CONFLUENCE_SPACE_KEY=
AQABSI_CONFLUENCE_PARENT_PAGE_ID=

# ClickUp: personal or oauth. The token variable accepts the selected mode.
AQABSI_CLICKUP_AUTH_MODE=personal
AQABSI_CLICKUP_API_TOKEN=
AQABSI_CLICKUP_WORKSPACE_ID=
AQABSI_CLICKUP_LIST_ID=

# Target application under test (web_login, bearer_token, basic_auth, sso_manual_handoff, none)
# Supply values via secret manager or local shell. Never paste passwords into chat.
AQABSI_TARGET_BASE_URL=
AQABSI_TARGET_AUTH_MODE=web_login
AQABSI_TEST_USERNAME=
AQABSI_TEST_PASSWORD=
AQABSI_TEST_TOKEN=
AQABSI_TARGET_LOGIN_PATH=

# Reviewed JSON mapping containing platform user IDs, never tokens.
AQABSI_OWNERSHIP_REGISTRY=
