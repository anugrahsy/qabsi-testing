{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aqabsi.uii.ac.id/schemas/profile.schema.json",
  "title": "AQABSI Layered Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "layer", "inherits", "selected_stack_profiles", "policy_overrides", "commands", "paths"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string"},
    "layer": {"type": "string", "enum": ["organization", "team", "project"]},
    "inherits": {"type": ["string", "null"]},
    "selected_stack_profiles": {"type": "array", "items": {"type": "string"}},
    "policy": {"type": "object"},
    "policy_overrides": {"type": "object"},
    "commands": {"type": "object", "additionalProperties": {"type": "string"}},
    "paths": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
