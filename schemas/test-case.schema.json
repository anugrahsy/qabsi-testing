{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qabsi.uii.ac.id/schemas/test-case.schema.json",
  "title": "QABSI Test Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "module", "feature", "layer", "scenario", "preconditions", "steps", "test_data", "expected_result", "actual_result", "status", "priority", "severity", "evidence", "owner_team"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"},
    "requirement_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "risk_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "module": {"type": "string", "minLength": 1},
    "feature": {"type": "string", "minLength": 1},
    "layer": {"type": "string", "enum": ["static", "unit", "component", "integration", "contract", "api", "e2e", "exploratory", "regression", "smoke", "security", "accessibility", "compatibility", "data", "migration", "resilience", "observability", "performance", "load", "stress", "endurance", "scalability", "reliability", "usability", "localization"]},
    "scenario": {"type": "string", "minLength": 1},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "steps": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "test_data": {"type": ["object", "array", "string", "number", "boolean", "null"]},
    "expected_result": {"type": "string", "minLength": 1},
    "actual_result": {"type": "string"},
    "status": {"type": "string", "enum": ["pass", "fail", "blocked", "skipped", "not_run", "flaky", "environment_error"]},
    "priority": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
    "severity": {"type": ["string", "null"], "enum": ["critical", "high", "medium", "low", "info", null]},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "owner_team": {"type": "string", "minLength": 1},
    "assignee_ref": {"type": ["string", "null"]},
    "notes": {"type": "string"}
  }
}
