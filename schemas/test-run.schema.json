{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aqabsi.uii.ac.id/schemas/test-run.schema.json",
  "title": "AQABSI Test Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "title", "module", "environment", "started_at", "source", "test_cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{3,80}$"},
    "title": {"type": "string", "minLength": 1},
    "module": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "enum": ["local", "test", "development", "staging", "production"]},
    "target": {"type": ["string", "null"]},
    "authorization_record": {"type": ["object", "null"]},
    "access_control_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "action", "resource", "expected", "actual", "status", "test_case_id", "error_location"],
        "properties": {
          "role": {"type": "string"},
          "action": {"type": "string"},
          "resource": {"type": "string"},
          "expected": {"type": "string"},
          "actual": {"type": "string"},
          "status": {"type": "string", "enum": ["pass", "fail", "blocked", "skipped", "not_run", "flaky", "environment_error"]},
          "test_case_id": {"type": "string"},
          "error_location": {"type": ["string", "null"]}
        }
      }
    },
    "security_findings": {"type": "array", "items": {"$ref": "security-finding.schema.json"}},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit_sha"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "pattern": "^[A-Fa-f0-9]{7,64}$"},
        "merge_request_url": {"type": ["string", "null"], "format": "uri"}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "test_cases": {"type": "array", "items": {"$ref": "test-case.schema.json"}}
  }
}
