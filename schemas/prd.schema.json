{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qabsi.uii.ac.id/schemas/prd.schema.json",
  "title": "QABSI Evidence-Backed PRD",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document", "summary", "scope", "requirements", "business_rules", "open_questions", "traceability"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "document": {
      "type": "object",
      "required": ["title", "version", "status", "evidence_cutoff"],
      "properties": {
        "title": {"type": "string"},
        "version": {"type": "string"},
        "status": {"type": "string", "enum": ["draft", "in_review", "approved", "superseded"]},
        "owner": {"type": ["string", "null"]},
        "reviewers": {"type": "array", "items": {"type": "string"}},
        "evidence_cutoff": {"type": "string", "format": "date-time"},
        "source_commits": {"type": "array", "items": {"type": "string"}}
      }
    },
    "summary": {"type": "string"},
    "scope": {
      "type": "object",
      "required": ["in_scope", "out_of_scope", "non_goals"],
      "properties": {
        "in_scope": {"type": "array", "items": {"type": "string"}},
        "out_of_scope": {"type": "array", "items": {"type": "string"}},
        "non_goals": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "dependencies": {"type": "array", "items": {"type": "string"}}
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "priority", "evidence_type", "source", "confidence", "acceptance_criteria"],
        "properties": {
          "id": {"type": "string", "pattern": "^FR-[A-Z0-9-]+$"},
          "statement": {"type": "string", "minLength": 1},
          "priority": {"type": "string", "enum": ["must", "should", "could", "wont_now"]},
          "evidence_type": {"type": "string", "enum": ["verified", "inferred", "assumption", "open_question", "recommendation"]},
          "source": {"type": "string"},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
          "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "business_rules": {"type": "array", "items": {"type": "object"}},
    "non_functional_requirements": {"type": "array", "items": {"type": "object"}},
    "risks": {"type": "array", "items": {"type": "object"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "open_questions": {"type": "array", "items": {"type": "object"}},
    "traceability": {"type": "array", "items": {"type": "object"}}
  }
}
