{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aqabsi.uii.ac.id/schemas/prd.schema.json",
  "title": "AQABSI Evidence-Backed PRD",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "document", "requirements", "traceability"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "document": {
      "type": "object",
      "required": ["title", "version", "status", "evidence_cutoff"],
      "properties": {
        "title": {"type": "string"},
        "version": {"type": "string"},
        "status": {"type": "string", "enum": ["draft", "in_review", "approved", "superseded"]},
        "owner": {"type": ["string", "null"]},
        "business_owner": {"type": ["string", "null"]},
        "technical_owner": {"type": ["string", "null"]},
        "qa_owner": {"type": ["string", "null"]},
        "reviewers": {"type": "array", "items": {"type": "string"}},
        "evidence_cutoff": {"type": "string", "format": "date-time"},
        "source_commits": {"type": "array", "items": {"type": "string"}}
      }
    },
    "quality_verdict": {"type": "string", "enum": ["review_ready", "needs_business_input", "needs_technical_evidence", "draft_incomplete"]},
    "prd_profile": {"type": "string"},
    "adaptive_sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "applicability"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "applicability": {"type": "string", "enum": ["required", "optional", "not_applicable"]},
          "rationale": {"type": "string"},
          "reviewer": {"type": ["string", "null"]},
          "content": {}
        }
      }
    },
    "summary": {"type": "string"},
    "evidence_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "type", "location", "classification", "confidence", "sensitivity"],
        "properties": {
          "id": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
          "type": {"type": "string"},
          "location": {"type": "string"},
          "classification": {"type": "string", "enum": ["verified", "inferred", "assumption", "open_question", "recommendation"]},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
          "sensitivity": {"type": "string", "enum": ["public", "internal", "internal_restricted", "confidential"]}
        }
      }
    },
    "scope": {
      "type": "object",
      "required": ["in_scope", "out_of_scope", "non_goals"],
      "properties": {
        "in_scope": {"type": "array", "items": {"type": "string"}},
        "out_of_scope": {"type": "array", "items": {"type": "string"}},
        "non_goals": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "dependencies": {"type": "array", "items": {"type": "string"}}
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "priority", "evidence_type", "source", "confidence", "acceptance_criteria"],
        "properties": {
          "id": {"type": "string", "pattern": "^FR-[A-Z0-9-]+$"},
          "statement": {"type": "string", "minLength": 1},
          "priority": {"type": "string", "enum": ["must", "should", "could", "wont_now"]},
          "evidence_type": {"type": "string", "enum": ["verified", "inferred", "assumption", "open_question", "recommendation"]},
          "source": {"type": "string"},
          "source_ids": {"type": "array", "items": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"}, "uniqueItems": true},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
          "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "error_behavior": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "business_rules": {"type": "array", "items": {"type": "object"}},
    "non_functional_requirements": {"type": "array", "items": {"type": "object"}},
    "risks": {"type": "array", "items": {"type": "object"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "open_questions": {"type": "array", "items": {"type": "object"}},
    "traceability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement_id", "source_ids", "risk_ids", "test_case_ids"],
        "properties": {
          "requirement_id": {"type": "string"},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "risk_ids": {"type": "array", "items": {"type": "string"}},
          "test_case_ids": {"type": "array", "items": {"type": "string"}},
          "result": {"type": ["string", "null"]},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "defect_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
